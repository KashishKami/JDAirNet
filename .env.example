# ─────────────────────────────────────────────────────────────────
# JDAirNet — Environment Variables
# Copy this file to .env.local (dev) and .env.test (testing)
# NEVER commit .env.local or .env.test to git
# ─────────────────────────────────────────────────────────────────

# Production domain (used in metadata, sitemaps, schema generators)
# Dev: http://127.0.0.1:3007   Prod: https://jdairnet.com
NEXT_PUBLIC_SITE_URL=http://127.0.0.1:3007

# Contact form PHP endpoint (deployed to Hostinger public_html/contact.php)
# In dev: this will 404 — expected. Playwright tests mock it.
NEXT_PUBLIC_CONTACT_ENDPOINT=/contact.php

# Blog feature flag — false until blog pages are built (Phase 7)
NEXT_PUBLIC_BLOG_ENABLED=false

# Google Analytics Measurement ID — leave empty during dev
NEXT_PUBLIC_GA_ID=

# Playwright E2E base URL — must match the dev server
PLAYWRIGHT_BASE_URL=http://127.0.0.1:3007
